		{
			"name": "9. Get Run Status - Delayed Run (Check While Waiting)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response contains wakeUpAt when waiting\", function () {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.status === 'waiting') {",
							"        pm.expect(jsonData).to.have.property('wakeUpAt');",
							"        pm.expect(jsonData.wakeUpAt).to.not.be.null;",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"if (!pm.collectionVariables.get(\"run_id_delay\")) {",
							"    throw new Error(\"Please run 'Trigger Journey - With Delay' first\");",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/journeys/runs/{{run_id_delay}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"journeys",
						"runs",
						"{{run_id_delay}}"
					]
				},
				"description": "Checks the status of the delayed run. If called immediately after trigger, status should be 'waiting' with a wakeUpAt timestamp. After 5+ seconds, status should be 'completed'."
			},
			"response": []
		},
		{
			"name": "10. Get Run Status - After Delay Completes",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Status is completed after delay\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.equal('completed');",
							"    pm.expect(jsonData.completedAt).to.not.be.null;",
							"});"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"if (!pm.collectionVariables.get(\"run_id_delay\")) {",
							"    throw new Error(\"Please run 'Trigger Journey - With Delay' first\");",
							"}",
							"",
							"// Wait 6 seconds before checking (delay is 5 seconds)",
							"setTimeout(function(){}, 6000);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/journeys/runs/{{run_id_delay}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"journeys",
						"runs",
						"{{run_id_delay}}"
					]
				},
				"description": "Wait 6+ seconds after triggering the delayed journey, then run this request. The status should now be 'completed'."
			},
			"response": []
		}
