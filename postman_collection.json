						"{{journey_id_delay}}",
						"trigger"
					]
				},
				"description": "Triggers the journey with a 5-second delay. Check the run status immediately (should be 'waiting'), then again after 5+ seconds (should be 'completed')."
			},
			"response": []
		},
		{
			"name": "7. Get Run Status - Senior Patient",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response contains execution log\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('executionLog');",
							"    pm.expect(jsonData.executionLog).to.be.an('array');",
							"});",
							"",
							"pm.test(\"Status is completed\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.equal('completed');",
							"});"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"if (!pm.collectionVariables.get(\"run_id_senior\")) {",
							"    throw new Error(\"Please run 'Trigger Journey - Inline Patient (Senior)' first\");",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/journeys/runs/{{run_id_senior}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"journeys",
						"runs",
						"{{run_id_senior}}"
					]
				},
				"description": "Retrieves the run status for the senior patient. Should show the journey took the 'senior_message' branch."
			},
			"response": []
		},
